# ============================================================================
# ARCHIVO: .env.example
# DESCRIPCIÓN: Variables de entorno requeridas para la plataforma en Next.js y Vercel.
# ============================================================================

# -------------------------------------------------------------
# 1. CREDENCIALES DE SUPABASE (Base de Datos PostgreSQL + Realtime)
# Obtén estos valores en el panel de Supabase: Project Settings > API
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_service_role_key

# -------------------------------------------------------------
# 2. CONFIGURACIÓN DE WHATSAPP CLOUD API (Meta for Developers - Opcional)
# Si deseas enviar y recibir mensajes directamente en Vercel sin servidor local:
# -------------------------------------------------------------
WHATSAPP_TOKEN=EAAG...tu_token_de_acceso_permanente_meta
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=secretaria_whatsapp_webhook_token_seguro

# -------------------------------------------------------------
# 3. ENLACE CON GATEWAY LOCAL BAILEYS (Opcional - Modo Híbrido)
# Si deseas que la app de Next.js despache mensajes a través de tu WhatsApp Web local:
# -------------------------------------------------------------
BAILEYS_GATEWAY_URL=http://localhost:3000

# -------------------------------------------------------------
# 4. URL PÚBLICA DE LA APLICACIÓN (Vercel)
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app
